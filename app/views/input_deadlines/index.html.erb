<% content_for :title, "入力締め切り日設定 | LibShiftAI_Pitat" %>

<div class="container py-5" style="max-width: 720px;">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h1 class="fs-4 fw-bold mb-1">入力締め切り日の設定</h1>
      <p class="text-muted small mb-0">
        職員が入力する「希望休」「スケジュール」の入力締め切り日を月ごとに設定します。<br>
        設定した締め切り日は、職員の入力画面（希望休登録・スケジュール登録）の両方に表示されます。
      </p>
    </div>
    <%= link_to shifts_path(month: @target_month.strftime("%Y-%m")),
        class: "btn btn-outline-secondary rounded-pill px-3" do %>
      ← シフト表に戻る
    <% end %>
  </div>

  <%# 月ナビゲーション %>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <%= link_to input_deadlines_path(month: (@target_month << 1).strftime("%Y-%m")),
        class: "btn btn-outline-secondary btn-sm rounded-pill px-3" do %>
      ＜ 前月
    <% end %>
    <h2 class="fs-5 fw-bold mb-0"><%= @target_month.strftime("%Y年%-m月") %></h2>
    <%= link_to input_deadlines_path(month: (@target_month >> 1).strftime("%Y-%m")),
        class: "btn btn-outline-secondary btn-sm rounded-pill px-3" do %>
      翌月 ＞
    <% end %>
  </div>

  <%# エラー表示 %>
  <% if @input_deadline.errors.any? %>
    <div class="alert alert-danger rounded-3 mb-3">
      <ul class="mb-0 ps-3">
        <% @input_deadline.errors.full_messages.each do |msg| %>
          <li class="small"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="pitat-card p-3 mb-4">
    <%= form_with url: save_input_deadlines_path(month: @target_month.strftime("%Y-%m")), method: :post do |f| %>
      <div class="mb-4">
        <label class="form-label small fw-semibold mb-1">入力締め切り日</label>
        <%= f.date_field :deadline_on, value: @input_deadline.deadline_on,
            class: "form-control form-control-sm" %>
      </div>
      <%= f.submit "保存する", class: "btn btn-pitat btn-sm rounded-pill px-4 fw-semibold" %>
    <% end %>
  </div>

  <%# 職員ごとの入力状況 %>
  <h2 class="fs-6 fw-bold mb-2">職員の入力状況</h2>
  <div class="pitat-card p-0 overflow-hidden">
    <table class="table table-hover mb-0 small align-middle">
      <thead class="table-light">
        <tr>
          <th class="ps-3 py-2 text-muted fw-semibold">職員</th>
          <th class="py-2 text-muted fw-semibold">希望休</th>
          <th class="py-2 pe-3 text-muted fw-semibold">スケジュール</th>
        </tr>
      </thead>
      <tbody>
        <% @staffs.each do |staff| %>
          <% submission = @submissions[staff.id] %>
          <tr>
            <td class="ps-3 py-2 fw-semibold">
              <%= staff.name %><span class="text-muted ms-1">（<%= staff.staff_type.name %>）</span>
            </td>
            <td class="py-2">
              <% if submission&.leave_submitted_at %>
                <span class="badge rounded-pill text-bg-success">入力済み</span>
              <% else %>
                <span class="badge rounded-pill text-bg-danger">未入力</span>
              <% end %>
            </td>
            <td class="py-2 pe-3">
              <% if submission&.schedule_submitted_at %>
                <span class="badge rounded-pill text-bg-success">入力済み</span>
              <% else %>
                <span class="badge rounded-pill text-bg-danger">未入力</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
