wb = xlsx_package.workbook
s  = wb.styles

# ---- スタイル定義（WEB画面の配色に合わせる） ----
base     = { font_name: "游ゴシック", sz: 9, border: { style: :thin, color: "CCCCCC" } }
center   = base.merge(alignment: { horizontal: :center, vertical: :center })
left     = base.merge(alignment: { horizontal: :left,   vertical: :center })
wrap     = base.merge(alignment: { horizontal: :left,   vertical: :center, wrap_text: true })

title_main_s  = s.add_style left.merge(b: true, sz: 14)
title_month_s = s.add_style left.merge(b: true, sz: 11)
title_blank_s = s.add_style base
info_label_s  = s.add_style left.merge(b: true, sz: 9, fg_color: "6C757D")
info_value_s  = s.add_style wrap.merge(sz: 9)
head_s        = s.add_style center.merge(bg_color: "F8F9FA", b: true)
wday_s        = s.add_style center.merge(bg_color: "F8F9FA")
sat_s         = s.add_style center.merge(bg_color: "DBEAFE", fg_color: "1D4ED8", b: true)
sun_s         = s.add_style center.merge(bg_color: "FEE2E2", fg_color: "DC2626", b: true)
hol_s         = s.add_style center.merge(bg_color: "FEE2E2", fg_color: "DC2626", b: true)
closed_s      = s.add_style center.merge(bg_color: "DEE2E6", fg_color: "6C757D")
name_s        = s.add_style left.merge(b: true, sz: 9)
type_s        = s.add_style left.merge(sz: 8, fg_color: "6C757D")
off_s         = s.add_style center.merge(fg_color: "6C757D")
leave_s       = s.add_style center.merge(bg_color: "FEF3C7", fg_color: "92400E", b: true)
work_s        = s.add_style center.merge(fg_color: "198754", b: true)
schedule_s    = s.add_style center.merge(bg_color: "D1FAE5", fg_color: "065F46", b: true)
early_s       = s.add_style center.merge(fg_color: "D97706", b: true)
post_s        = s.add_style center.merge(fg_color: "2563EB", b: true)
hol_post_s    = s.add_style center.merge(bg_color: "FEE2E2", fg_color: "DC2626", b: true)
error_s       = s.add_style center.merge(bg_color: "F8D7DA", fg_color: "842029", b: true)
count_s       = s.add_style center.merge(bg_color: "DCFCE7", b: true, fg_color: "166534")
total_s       = s.add_style center.merge(bg_color: "EFF6FF", b: true, fg_color: "1E40AF")
label_s       = s.add_style left.merge(bg_color: "F8F9FA", b: true, sz: 9)

day_names = %w[日 月 火 水 木 金 土]

# セルの値とスタイルを決定するヘルパー
leave_reason_labels = { "公休" => "休", "年休" => "年", "夏期休暇" => "夏" }

cell_val = lambda do |staff, date|
  shift = @shifts_map.dig(staff.id, date)
  errors = shift && shift.validation_errors.present? ? (JSON.parse(shift.validation_errors) rescue []) : []

  if @closed_days.key?(date) && !shift&.is_working && !shift&.is_holiday_post_duty
    return ["－", closed_s]
  end
  if errors.any?
    mark = shift&.is_working ? "○" : "!"
    return [mark, error_s]
  end

  leave     = @leave_map[[staff.id, date]]
  lr_reason = @leave_requests_map[[staff.id, date]]
  if leave
    [ActualLeave::LEAVE_TYPES[leave.leave_type], leave_s]
  elsif lr_reason && !shift&.is_working
    [leave_reason_labels[lr_reason] || "休", leave_s]
  elsif shift&.is_working
    if shift.is_early
      ["早", early_s]
    elsif shift.is_holiday_post_duty
      ["Ｐ", hol_post_s]
    elsif shift.is_post_duty
      ["ｐ", post_s]
    elsif @schedule_map[[staff.id, date]]
      ["○", schedule_s]
    else
      ["○", work_s]
    end
  elsif shift&.is_holiday_post_duty
    ["Ｐ", hol_post_s]
  else
    ["－", off_s]
  end
end

working_days_count = lambda do |staff|
  @dates.count do |date|
    shift     = @shifts_map.dig(staff.id, date)
    next false if @closed_days.key?(date) && !shift&.is_working
    leave     = @leave_map[[staff.id, date]]
    lr_reason = @leave_requests_map[[staff.id, date]]
    paid_leave = %w[年休 夏期休暇].include?(lr_reason)
    leave.present? || shift&.is_working || paid_leave
  end
end

daily_count = lambda do |date|
  next nil if @closed_days.key?(date)
  @staffs.count do |staff|
    shift = @shifts_map.dig(staff.id, date)
    leave = @leave_map[[staff.id, date]]
    leave.present? || shift&.is_working
  end
end

# 年度表記
fiscal_year = @target_month.month >= 4 ? @target_month.year : @target_month.year - 1
reiwa_year  = fiscal_year - 2018
month_label = "令和#{reiwa_year}年（#{@target_month.year}年）#{@target_month.month}月分"
sheet_name  = "R#{reiwa_year}.#{@target_month.month}月"

wb.add_worksheet(name: sheet_name) do |sheet|
  col_count = @dates.size + 4  # A(区分) B(職種) C(氏名) + 日付列 + 勤務日数列

  # ---- 印刷設定：A4横 1ページに収める ----
  sheet.page_setup.paper_size = 9 # A4
  sheet.page_setup.orientation = :landscape
  sheet.page_setup.fit_to(width: 1, height: 1)
  sheet.page_margins.set(left: 0.25, right: 0.25, top: 0.3, bottom: 0.3, header: 0.1, footer: 0.1)

  # --- 行1: タイトル ---
  row1_data  = Array.new(col_count, "")
  row1_style = Array.new(col_count, title_blank_s)
  row1_data[0]  = "勤務予定表"
  row1_style[0] = title_main_s
  row1_data[2]  = month_label
  row1_style[2] = title_month_s
  sheet.add_row row1_data, style: row1_style, height: 22
  sheet.merge_cells "A1:B1"
  sheet.merge_cells "C1:H1"

  # 件数がどれだけ増えても取りこぼさないよう、labelは初回行だけに付け、
  # itemsをper_line件ずつ複数行に分けて出力する（1行の固定高さに収めようと
  # せず行数側を増やすことで、はみ出て読めなくなることを防ぐ）
  add_info_rows = lambda do |label, items, per_line|
    slices = items.each_slice(per_line).to_a
    slices = [[]] if slices.empty?
    slices.each_with_index do |slice, i|
      row_data  = Array.new(col_count, "")
      row_style = Array.new(col_count, title_blank_s)
      row_data[0]  = i.zero? ? label : ""
      row_style[0] = info_label_s
      row_data[2]  = slice.join("　")
      row_style[2] = info_value_s
      sheet.add_row row_data, style: row_style, height: 14
      r = sheet.rows.size
      sheet.merge_cells "A#{r}:B#{r}"
      sheet.merge_cells "C#{r}:#{Axlsx.col_ref(col_count - 1)}#{r}"
    end
  end

  # --- 月の勤務日数目標 ---
  add_info_rows.call(
    "月の勤務日数目標",
    ["正規職員：#{@working_days[:regular]}日　会計年度任用職員：#{@working_days[:hourly]}日"],
    1
  )

  # --- 休館日 ---
  closed_items = @closed_days.map { |date, label| "#{date.strftime('%-m/%-d')}(#{label})" }
  add_info_rows.call("休館日（#{@closed_days.size}日）", closed_items, 7)

  # --- スケジュール（登録がある場合のみ） ---
  if @special_date_labels.any?
    sched_items = @special_date_labels.sort.map { |date, labels| "#{date.strftime('%-m/%-d')}（#{labels.join('・')}）" }
    add_info_rows.call("スケジュール", sched_items, 4)
  end

  # --- 空白行 ---
  sheet.add_row Array.new(col_count, ""), style: Array.new(col_count, title_blank_s), height: 4

  # --- 日付 ---
  date_row  = ["", "", ""]
  date_styl = [head_s, head_s, head_s]
  @dates.each do |d|
    date_row  << d.day
    if @closed_days.key?(d)
      date_styl << closed_s
    elsif d.saturday?
      date_styl << sat_s
    elsif d.sunday? || @holidays_in_month.key?(d)
      date_styl << sun_s
    else
      date_styl << wday_s
    end
  end
  date_row  << "勤務日数"
  date_styl << head_s
  sheet.add_row date_row, style: date_styl, height: 14

  # --- 曜日 ---
  wday_row  = ["", "職種", "氏名"]
  wday_styl = [head_s, head_s, head_s]
  @dates.each do |d|
    wday_row << day_names[d.wday]
    if @closed_days.key?(d)
      wday_styl << closed_s
    elsif d.saturday?
      wday_styl << sat_s
    elsif d.sunday? || @holidays_in_month.key?(d)
      wday_styl << sun_s
    else
      wday_styl << wday_s
    end
  end
  wday_row  << ""
  wday_styl << head_s
  sheet.add_row wday_row, style: wday_styl, height: 14

  # --- 定休・祝日マーク ---
  mark_row  = ["", "", ""]
  mark_styl = [label_s, label_s, label_s]
  @dates.each do |d|
    label = @closed_days[d]
    if label
      mark_row  << (label.include?("祝") ? "祝" : "定休")
      mark_styl << closed_s
    elsif @holidays_in_month.key?(d)
      mark_row  << "祝"
      mark_styl << hol_s
    else
      mark_row  << ""
      mark_styl << wday_s
    end
  end
  mark_row  << ""
  mark_styl << label_s
  sheet.add_row mark_row, style: mark_styl, height: 12

  # --- 職員行 ---
  regular_staffs = @staffs.select { |s| s.employment_type.name == "正規職員" }
  hourly_staffs  = @staffs.reject { |s| s.employment_type.name == "正規職員" }

  [[regular_staffs, "正規職員"], [hourly_staffs, "会計年度\n任用職員"]].each do |group_staffs, group_label|
    group_staffs.each_with_index do |staff, idx|
      row_data  = [idx == 0 ? group_label : "", staff.staff_type.name, staff.name]
      row_styl  = [label_s, type_s, name_s]

      @dates.each do |date|
        val, sty = cell_val.call(staff, date)
        row_data << val
        row_styl << sty
      end

      row_data << working_days_count.call(staff)
      row_styl << total_s

      sheet.add_row row_data, style: row_styl, height: 14
    end
  end

  # --- 出勤人数行 ---
  cnt_row  = ["", "", "出勤人数"]
  cnt_styl = [label_s, label_s, label_s]
  @dates.each do |date|
    cnt_row  << (daily_count.call(date) || "")
    cnt_styl << (@closed_days.key?(date) ? closed_s : count_s)
  end
  cnt_row  << ""
  cnt_styl << label_s
  sheet.add_row cnt_row, style: cnt_styl, height: 14

  # --- 列幅 ---
  # A(区分)=5, B(職種)=10, C(氏名)=10, 日付列×n=3.2, 勤務日数=8
  sheet.column_widths 5, 10, 10, *Array.new(@dates.size, 3.2), 8
end
