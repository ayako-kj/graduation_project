<% content_for :title, "職員一覧 | LibShift_Pitat" %>

<style>
  .drag-handle {
    width: 32px;
    height: 32px;
    border: 1px solid #dee2e6;
    color: #6c757d;
    background-color: #fff;
    cursor: grab;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .drag-handle:hover {
    background-color: #f8f9fa;
    border-color: #adb5bd;
    color: #495057;
  }
  #staff-sortable-body tr.dragging .drag-handle {
    cursor: grabbing;
  }
</style>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="fs-4 fw-bold mb-0">職員一覧</h1>
    <%= link_to "＋ 職員を登録する", new_staff_path, class: "btn btn-pitat rounded-pill px-4" %>
  </div>

  <% if @staffs.empty? %>
    <div class="pitat-card p-5 text-center text-muted">
      <i class="bi bi-people fs-1 d-block mb-3"></i>
      <p class="mb-3">まだ職員が登録されていません。</p>
      <%= link_to "職員を登録する", new_staff_path, class: "btn btn-pitat rounded-pill px-4" %>
    </div>
  <% else %>
    <div class="pitat-card p-0 overflow-hidden">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4 py-3 text-muted small fw-semibold">氏名</th>
            <th class="py-3 text-muted small fw-semibold">職種</th>
            <th class="py-3 text-muted small fw-semibold">雇用形態</th>
            <th class="py-3 text-muted small fw-semibold">週勤務日数</th>
            <th class="py-3 text-muted small fw-semibold">在籍状況</th>
            <th class="py-3 text-muted small fw-semibold text-center" style="width:48px;">並び替え</th>
            <th class="py-3"></th>
          </tr>
        </thead>
        <tbody id="staff-sortable-body">
          <% @staffs.each do |staff| %>
            <tr class="<%= "text-muted" if staff.retired? %>" data-staff-id="<%= staff.id %>" draggable="true">
              <td class="ps-4 py-3 fw-semibold"><%= staff.name %></td>
              <td class="py-3"><%= staff.staff_type.name %></td>
              <td class="py-3"><%= staff.employment_type.name %></td>
              <td class="py-3"><%= staff.weekly_work_days ? "#{staff.weekly_work_days}日" : "－" %></td>
              <td class="py-3">
                <% if staff.retired? %>
                  <span class="badge bg-secondary">退職済み（<%= staff.retired_on.strftime('%Y/%-m/%-d') %>）</span>
                <% elsif staff.hired_on.present? && staff.hired_on > Date.today %>
                  <span class="badge bg-info text-dark">入社予定（<%= staff.hired_on.strftime('%Y/%-m/%-d') %>）</span>
                <% else %>
                  <span class="badge bg-success">在籍中</span>
                <% end %>
              </td>
              <td class="py-3 text-center">
                <span class="drag-handle d-inline-flex align-items-center justify-content-center rounded-circle"
                      title="ドラッグして並び替え">
                  <i class="bi bi-list"></i>
                </span>
              </td>
              <td class="py-3 pe-4 text-end">
                <%= link_to "編集", edit_staff_path(staff), class: "btn btn-sm btn-outline-secondary rounded-pill px-3 me-1" %>
                <%= link_to "削除", staff_path(staff),
                    data: { turbo_method: :delete, turbo_confirm: "#{staff.name}を削除しますか？" },
                    class: "btn btn-sm btn-outline-danger rounded-pill px-3" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<script>
  (function () {
    function initStaffSortable() {
      const tbody = document.getElementById("staff-sortable-body");
      if (!tbody) return;

      let draggingRow = null;

      function handleDragStart(e) {
        draggingRow = e.currentTarget;
        e.dataTransfer.effectAllowed = "move";
        draggingRow.classList.add("opacity-50", "dragging");
      }

      function handleDragEnd() {
        if (draggingRow) draggingRow.classList.remove("opacity-50", "dragging");
        draggingRow = null;
        saveOrder();
      }

      function handleDragOver(e) {
        e.preventDefault();
        const targetRow = e.currentTarget;
        if (!draggingRow || targetRow === draggingRow) return;

        const rect = targetRow.getBoundingClientRect();
        const before = (e.clientY - rect.top) < rect.height / 2;
        tbody.insertBefore(draggingRow, before ? targetRow : targetRow.nextSibling);
      }

      function saveOrder() {
        const ids = Array.from(tbody.querySelectorAll("tr")).map((row) => row.dataset.staffId);
        const token = document.querySelector('meta[name="csrf-token"]').content;
        fetch("<%= reorder_staffs_path %>", {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": token
          },
          body: JSON.stringify({ ordered_ids: ids })
        });
      }

      tbody.querySelectorAll("tr").forEach((row) => {
        row.addEventListener("dragstart", handleDragStart);
        row.addEventListener("dragend", handleDragEnd);
        row.addEventListener("dragover", handleDragOver);
      });
    }

    document.addEventListener("DOMContentLoaded", initStaffSortable);
    document.addEventListener("turbo:load", initStaffSortable);
  }());
</script>
