<% content_for :title, "希望休入力 | LibShift_Pitat" %>
<%# 振替休日・時間休のタップ状態を未保存のままキャッシュから復元してしまう
    と、実際には選択していない日まで表示されてしまうため、このページは
    Turboのキャッシュ対象から除外し、常にサーバーから最新の状態を取得する %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<style>
  .date-card {
    cursor: pointer;
    transition: background-color 0.1s, border-color 0.1s, color 0.1s;
    user-select: none;
  }
  .date-card:hover { opacity: 0.8; }
  .type-btn { opacity: 0.45; transition: opacity 0.15s; }
  .type-btn.active { opacity: 1; box-shadow: 0 0 0 2px rgba(0,0,0,0.15); }
</style>

<div class="container py-5" style="max-width: 720px;">

  <div class="text-center mb-4">
    <p class="text-muted small mb-1">LibShift Pitat</p>
    <h1 class="fs-3 fw-bold mb-1">希望休の入力</h1>
    <p class="text-muted">こんにちは、<strong class="text-dark"><%= @current_staff.name %></strong>さん</p>
  </div>

  <%# 月ナビゲーション %>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <%= link_to staff_leave_input_path(token: params[:token], month: (@target_month << 1).strftime("%Y-%m")),
        class: "btn btn-outline-secondary btn-sm rounded-pill px-3" do %>
      ＜ 前月
    <% end %>
    <h2 class="fs-5 fw-bold mb-0"><%= @target_month.strftime("%Y年%-m月") %></h2>
    <%= link_to staff_leave_input_path(token: params[:token], month: (@target_month >> 1).strftime("%Y-%m")),
        class: "btn btn-outline-secondary btn-sm rounded-pill px-3" do %>
      翌月 ＞
    <% end %>
  </div>

  <% if @input_deadline&.deadline_on %>
    <% overdue = Date.today > @input_deadline.deadline_on %>
    <div class="pitat-card p-3 mb-3 fs-6 text-center fw-semibold <%= overdue ? 'text-danger' : 'text-dark' %>">
      <i class="bi bi-alarm me-1"></i>
      入力締め切り：<%= @input_deadline.deadline_on.strftime("%Y年%-m月%-d日（#{%w[日 月 火 水 木 金 土][@input_deadline.deadline_on.wday]}）") %>
      <% if overdue %>（締め切りを過ぎています）<% end %>
    </div>
  <% end %>

  <div class="pitat-card p-3 mb-3 small text-center">
    <% if @submission&.leave_submitted_at %>
      <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>提出済み</span>
      <span class="text-muted ms-1">（<%= @submission.leave_submitted_at.strftime("%-m/%-d %H:%M") %> 保存）</span>
    <% else %>
      <span class="text-muted"><i class="bi bi-exclamation-circle me-1"></i>まだ保存されていません（休みがない場合も、そのまま保存してください）</span>
    <% end %>
  </div>

  <div class="pitat-card p-3 mb-3 small text-muted">
    <i class="bi bi-info-circle me-1"></i>
    休暇の種別を選んでから日付をタップしてください。もう一度タップすると解除できます。休館日は選択できません。
  </div>

  <%= form_with url: save_staff_leave_input_path(token: params[:token], month: @target_month.strftime("%Y-%m")),
      method: :post do |f| %>

    <%# 種別選択 %>
    <div class="pitat-card p-3 mb-3">
      <div class="small fw-semibold mb-2 text-muted">① 休暇の種別を選ぶ</div>
      <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-sm type-btn active"
                data-type="公休"
                onclick="selectLeaveType('公休')"
                style="background-color:#FEF3C7; border-color:#f59e0b; color:#92400E;">
          ● 公休（希望休）
        </button>
        <button type="button" class="btn btn-sm type-btn"
                data-type="振替休日"
                onclick="selectLeaveType('振替休日')"
                style="background-color:#FCE7F3; border-color:#db2777; color:#831843;">
          ● 振替休日
        </button>
        <button type="button" class="btn btn-sm type-btn"
                data-type="年休"
                onclick="selectLeaveType('年休')"
                style="background-color:#D1FAE5; border-color:#059669; color:#065f46;">
          ● 年休
        </button>
        <button type="button" class="btn btn-sm type-btn"
                data-type="夏期休暇"
                onclick="selectLeaveType('夏期休暇')"
                style="background-color:#DBEAFE; border-color:#2563eb; color:#1e3a8a;">
          ● 夏期休暇
        </button>
        <button type="button" class="btn btn-sm type-btn"
                data-type="病気休暇"
                onclick="selectLeaveType('病気休暇')"
                style="background-color:#FEE2E2; border-color:#dc2626; color:#7f1d1d;">
          ● 病気休暇
        </button>
        <button type="button" class="btn btn-sm type-btn"
                data-type="特別休暇"
                onclick="selectLeaveType('特別休暇')"
                style="background-color:#EDE9FE; border-color:#7c3aed; color:#4c1d95;">
          ● 特別休暇
        </button>
      </div>
    </div>

    <%# カレンダー %>
    <div class="pitat-card p-3 mb-3">
      <div class="small fw-semibold mb-2 text-muted">② 日付をタップする</div>
      <div class="d-flex flex-wrap gap-2 justify-content-start">
        <% wday_names = %w[日 月 火 水 木 金 土] %>
        <% @dates.each do |date| %>
          <% is_closed   = @closed_days.key?(date) %>
          <% leave_type  = @existing_leaves[date] %>

          <% if is_closed %>
            <div class="text-center rounded border px-2 py-2"
                 style="min-width:52px; background-color:#f3f4f6; color:#9ca3af; border-color:#e5e7eb;">
              <div class="small fw-bold"><%= date.day %></div>
              <div style="font-size:0.7rem;"><%= wday_names[date.wday] %></div>
              <div style="font-size:0.65rem;">休館</div>
            </div>
          <% else %>
            <input type="checkbox"
                   id="check-<%= date %>"
                   name="leave_dates[]"
                   value="<%= date %>"
                   <%= leave_type ? "checked" : "" %>
                   style="display:none;">
            <input type="hidden"
                   id="type-<%= date %>"
                   name="leave_types[<%= date %>]"
                   value="<%= leave_type || '' %>">
            <div class="date-card rounded border text-center px-2 py-2"
                 id="card-<%= date %>"
                 style="min-width:52px;"
                 onclick="toggleDate('<%= date %>')">
              <div class="small fw-bold"><%= date.day %></div>
              <div style="font-size:0.7rem;"><%= wday_names[date.wday] %></div>
              <div class="leave-label fw-semibold" style="font-size:0.65rem;"></div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# 振替休日の対象日（振替休日を選んだ日のみ表示） %>
    <div class="pitat-card p-3 mb-3" id="substitute-section" style="<%= @existing_leaves.value?('振替休日') ? '' : 'display:none;' %>">
      <div class="small fw-semibold mb-2 text-muted">振替休日の内訳（出勤した日を入力してください）</div>
      <div class="d-flex flex-column gap-2">
        <% @dates.each do |date| %>
          <% next if @closed_days.key?(date) %>
          <div class="substitute-row" id="substitute-row-<%= date %>"
               style="align-items:center; gap:0.5rem; <%= @existing_leaves[date] == '振替休日' ? 'display:flex;' : 'display:none;' %>">
            <label class="small text-muted mb-0" style="min-width:110px;"><%= date.strftime("%-m/%-d（#{wday_names[date.wday]}）") %>の振替：</label>
            <input type="date" class="form-control form-control-sm" style="max-width:160px;"
                   name="substitute_work_dates[<%= date %>]"
                   value="<%= @existing_substitute_work_dates[date]&.strftime('%Y-%m-%d') %>"
                   <%= @existing_leaves[date] == '振替休日' ? "required" : "" %>>
          </div>
        <% end %>
      </div>
    </div>

    <%# 時間休 %>
    <div class="pitat-card p-3 mb-3">
      <div class="small fw-semibold mb-2 text-muted">③ 時間休を取得する日があれば選ぶ（任意）</div>
      <div class="text-muted small mb-2">
        通常通り出勤し、数時間だけ休むための登録です。その日は早番・ポスト当番の割当対象から外れます。
      </div>
      <div class="d-flex flex-column gap-2" style="max-height: 240px; overflow-y: auto;">
        <% @dates.each do |date| %>
          <% next if @closed_days.key?(date) %>
          <% existing_label = @existing_hourly_leaves[date] %>
          <div class="d-flex align-items-center gap-2">
            <div class="form-check mb-0" style="min-width:110px;">
              <input type="checkbox" class="form-check-input"
                     id="hourly-check-<%= date %>"
                     name="hourly_leave_dates[]"
                     value="<%= date %>"
                     <%= @existing_hourly_leaves.key?(date) ? "checked" : "" %>
                     onclick="toggleHourlyLabel('<%= date %>')">
              <label class="form-check-label small" for="hourly-check-<%= date %>">
                <%= date.strftime("%-m/%-d（#{wday_names[date.wday]}）") %>
              </label>
            </div>
            <input type="text" class="form-control form-control-sm"
                   id="hourly-label-<%= date %>"
                   name="hourly_leave_labels[<%= date %>]"
                   placeholder="時間帯（必須・例：15:00〜17:00）"
                   value="<%= existing_label %>"
                   <%= @existing_hourly_leaves.key?(date) ? "required" : "" %>
                   style="max-width:260px; flex:1 1 auto; min-width:200px; <%= @existing_hourly_leaves.key?(date) ? '' : 'display:none;' %>">
          </div>
        <% end %>
      </div>
    </div>

    <%# 選択サマリー %>
    <div class="pitat-card p-3 mb-4 small" id="selected-summary">
      <div class="fw-semibold text-muted mb-1">現在の希望休：</div>
      <% if @existing_leaves.any? %>
        <% @existing_leaves.group_by { |_, v| v }.sort.each do |type, pairs| %>
          <div>
            <span class="fw-semibold"><%= type %>：</span>
            <% if type == "振替休日" %>
              <%= pairs.sort_by { |d, _| d }.map { |d, _|
                    sub = @existing_substitute_work_dates[d]
                    "#{d.month}/#{d.day}#{"（#{sub.month}/#{sub.day}出勤分）" if sub}"
                  }.join("、") %>
            <% else %>
              <%= pairs.sort_by { |d, _| d }.map { |d, _| "#{d.month}/#{d.day}" }.join("、") %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <span class="text-muted">なし</span>
      <% end %>
      <div class="fw-semibold text-muted mb-1 mt-2">現在の時間休：</div>
      <% if @existing_hourly_leaves.any? %>
        <div>
          <%= @existing_hourly_leaves.sort_by { |d, _| d }.map { |d, label| "#{d.month}/#{d.day}#{"（#{label}）" if label.present?}" }.join("、") %>
        </div>
      <% else %>
        <span class="text-muted">なし</span>
      <% end %>
      <div class="text-muted" style="font-size:0.75rem; margin-top:4px;">※ 保存後に反映されます</div>
    </div>

    <div class="text-center">
      <%= f.submit "#{@target_month.strftime('%Y年%-m月')}の希望休を保存する",
          class: "btn btn-pitat rounded-pill px-5 fw-semibold" %>
    </div>
  <% end %>
</div>

<script>
  const TYPE_STYLES = {
    '公休':   { bg: '#FEF3C7', border: '#f59e0b', color: '#92400E' },
    '振替休日': { bg: '#FCE7F3', border: '#db2777', color: '#831843' },
    '年休':   { bg: '#D1FAE5', border: '#059669', color: '#065f46' },
    '夏期休暇': { bg: '#DBEAFE', border: '#2563eb', color: '#1e3a8a' },
    '病気休暇': { bg: '#FEE2E2', border: '#dc2626', color: '#7f1d1d' },
    '特別休暇': { bg: '#EDE9FE', border: '#7c3aed', color: '#4c1d95' }
  };

  let currentType = '公休';

  function selectLeaveType(type) {
    currentType = type;
    document.querySelectorAll('.type-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.type === type);
    });
  }

  function applyCardStyle(card, label, type) {
    if (type && TYPE_STYLES[type]) {
      const s = TYPE_STYLES[type];
      card.style.backgroundColor = s.bg;
      card.style.borderColor = s.border;
      card.style.color = s.color;
      label.textContent = type;
    } else {
      card.style.backgroundColor = 'white';
      card.style.borderColor = '';
      card.style.color = '';
      label.textContent = '';
    }
  }

  function toggleDate(dateStr) {
    const checkbox  = document.getElementById('check-' + dateStr);
    const typeInput = document.getElementById('type-'  + dateStr);
    const card      = document.getElementById('card-'  + dateStr);
    const label     = card.querySelector('.leave-label');
    const isRemoving = checkbox.checked && typeInput.value === currentType;

    // 時間休が既に設定されている日には、終日休みを追加で設定できない
    // （出勤している前提の時間休と、終日休みの希望休は矛盾するため）
    if (!isRemoving) {
      const hourlyCheckbox = document.getElementById('hourly-check-' + dateStr);
      if (hourlyCheckbox && hourlyCheckbox.checked) {
        alert(dateStr + "は時間休が設定されているため、" + currentType + "として登録できません。\n先に時間休を解除してください。");
        return;
      }
    }

    if (isRemoving) {
      checkbox.checked = false;
      typeInput.value  = '';
      applyCardStyle(card, label, null);
    } else {
      checkbox.checked = true;
      typeInput.value  = currentType;
      applyCardStyle(card, label, currentType);
    }
    updateSubstituteRow(dateStr, typeInput.value);
  }

  function updateSubstituteRow(dateStr, type) {
    const row = document.getElementById('substitute-row-' + dateStr);
    if (!row) return;
    row.style.display = type === '振替休日' ? 'flex' : 'none';
    const dateInput = row.querySelector('input[type="date"]');
    dateInput.required = type === '振替休日';
    if (type !== '振替休日') dateInput.value = '';

    const section = document.getElementById('substitute-section');
    const anyVisible = Array.from(document.querySelectorAll('.substitute-row'))
      .some(r => r.style.display !== 'none');
    section.style.display = anyVisible ? '' : 'none';
  }

  function toggleHourlyLabel(dateStr) {
    const checkbox = document.getElementById('hourly-check-' + dateStr);
    const input    = document.getElementById('hourly-label-' + dateStr);

    // 終日休みが既に設定されている日には、時間休を追加で設定できない
    if (checkbox.checked) {
      const leaveCheckbox = document.getElementById('check-' + dateStr);
      if (leaveCheckbox && leaveCheckbox.checked) {
        const typeInput = document.getElementById('type-' + dateStr);
        checkbox.checked = false;
        alert(dateStr + "は希望休（" + typeInput.value + "）が設定されているため、時間休を登録できません。\n先に希望休を解除してください。");
        return;
      }
    }

    input.style.display = checkbox.checked ? '' : 'none';
    input.required = checkbox.checked;
    if (!checkbox.checked) input.value = '';
  }

  // ページ読み込み時に既存データのカードに色を適用（Turbo対応）
  function initCards() {
    document.querySelectorAll('input[name="leave_dates[]"]').forEach(cb => {
      if (!cb.checked) return;
      const dateStr   = cb.value;
      const typeInput = document.getElementById('type-' + dateStr);
      const card      = document.getElementById('card-' + dateStr);
      if (!card) return;
      const label     = card.querySelector('.leave-label');
      applyCardStyle(card, label, typeInput.value || '公休');
    });
  }

  document.addEventListener('DOMContentLoaded', initCards);
  document.addEventListener('turbo:load', initCards);
</script>
